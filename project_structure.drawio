        </mxCell>
        <mxCell id="config" value="&lt;b&gt;config.py&lt;/b&gt;&lt;br&gt;BOT_TOKEN, ADMIN_ID,&lt;br&gt;GEMINI_API_KEY, OPEN_AI_API_KEY,&lt;br&gt;CONFIRM_SIZE_MB, DOWNLOADS_DIR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="main" value="&lt;b&gt;main.py&lt;/b&gt; 🚀&lt;br&gt;Точка входа:&lt;br&gt;set_bot_commands(),&lt;br&gt;include_router(), polling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="860" y="60" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="loader" value="&lt;b&gt;loader.py&lt;/b&gt;&lt;br&gt;bot = Bot(), dp = Dispatcher(),&lt;br&gt;cleaner = DownloadsCleaner(),&lt;br&gt;dn = Downloader(cleaner)&lt;br&gt;локальный Bot API (если TELEGRAM_API_URL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="210" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="handlers" value="&lt;b&gt;handlers.py&lt;/b&gt; — router загрузок&lt;br&gt;• /start, /init_tg (admin)&#10;• Ловит ссылки → метаданные → подтверждение размера&#10;• _run_download(): видео / фото / карусель&#10;• подтверждение перед отправкой, если реальный файл больше лимита&#10;• PENDING_DOWNLOADS / PENDING_UPLOADS (in-memory)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="380" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="downloader" value="&lt;b&gt;downloader.py&lt;/b&gt; — class Downloader&lt;br&gt;• download_video() — yt-dlp&#10;• get_video_meta() — метаданные без скачивания&#10;• _estimate_filesize() — оценка размера (requested_formats / video+audio)&#10;• download_instagram_photos() — instaloader&#10;• удаление через cleaner (DownloadsCleaner)&#10;• кодеки/ffmpeg по платформам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="630" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cleanup" value="&lt;b&gt;cleanup.py&lt;/b&gt; — class DownloadsCleaner&lt;br&gt;• remove(path) — файл (с «хвостами»)/папка&#10;• sweep(protected, force) — проход по downloads/&#10;• неблокирующий замок от параллельных уборок" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="640" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="aih" value="&lt;b&gt;ai_handlers.py&lt;/b&gt; — ai_router&lt;br&gt;• /ai &amp;lt;вопрос&amp;gt;&#10;• user_history в памяти (TTL 1 час)&#10;• подгружает историю из Telegram" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
